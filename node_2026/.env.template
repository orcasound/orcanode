AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_METADATA_SERVICE_TIMEOUT=5
AWS_METADATA_SERVICE_NUM_ATTEMPTS=0
REGION=us-west-2
#BUCKET_TYPE=dev
BUCKET_TYPE=prod
# Custom buckets, only used when BUCKET_TYPE=custom
# HLS streaming bucket (all nodes)
#BUCKET_STREAMING=<your-streaming-bucket-name>
# FLAC archive bucket (research nodes)
#BUCKET_ARCHIVE=<your-archive-bucket-name>
#NODE_TYPE=research
NODE_TYPE=hls-only
NODE_NAME=rpi_orcasound_lab
NODE_LOOPBACK=false
SAMPLE_RATE=48000
AUDIO_HW_ID=pisound
CHANNELS=2
#LOGDNA_INGESTION_KEY=<your-mezmo-ingestion-key>
FLAC_DURATION=30
SEGMENT_DURATION=10
# true = UTC in FLAC filenames and HLS timestamps; false = Pi local time
UTC_TIME=false
# Wait up to 60 s for the kernel to report a synchronised clock before
# capturing. false = start regardless (test machines with no NTP daemon).
#REQUIRE_TIME_SYNC=true
LC_ALL=C.UTF-8
NO_UPLOAD=true

# Latency test marker (stream_sync_latency.sh only — see README).
CHECK_LATENCY=false
#LATENCY_PULSE_DURATION_MS=50
#LATENCY_PULSE_FREQ_HZ=1000
