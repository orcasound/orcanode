# Copy to .env and fill in for your deployment.
# .env is git-ignored — never commit real values (keys, IPs, paths, identifiers).

# --- Node identity ---
NODE_NAME=my_node          # used in S3 key paths and local dirs
NODE_TYPE=hls-only         # hls-only | research | dev-virt-s3 | file-archive | iclisten
LC_ALL=C.UTF-8             # stable container locale

# --- Output (all node types) ---
CHANNELS=1                 # output channel count
SEGMENT_DURATION=10        # HLS segment length, seconds

# --- Audio input (soundcard / jack node types only) ---
AUDIO_HW_ID=USB            # ALSA card name from `arecord -L` (e.g. pisound, USB)
SAMPLE_RATE=48000          # capture rate
NODE_LOOPBACK=false        # jack loopback: true | false | hls
FLAC_DURATION=30           # research mode only: FLAC archive segment length

# --- Storage / AWS ---
REGION=us-west-2
BUCKET_TYPE=dev            # dev | prod | custom
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_METADATA_SERVICE_TIMEOUT=5      # avoid slow EC2-metadata probes on non-EC2 hosts
AWS_METADATA_SERVICE_NUM_ATTEMPTS=0

# --- Logging (optional) ---
#SYSLOG_URL=
#SYSLOG_STRUCTURED_DATA=

# --- file-archive mode: stream a rolling archive of timestamped audio files ---
# Plays files whose names embed a UTC recording start time, held ARCHIVE_DELAY
# seconds behind real time. The source can be any host mount (SMB/NFS/local/...):
# mount it, point ARCHIVE_MOUNT at that host path and ARCHIVE_DIR at the files.
# ARCHIVE_PATTERNS is a strptime pattern for the WHOLE filename — it both selects
# matching files and parses their start time. One output channel per pattern, in the
# order listed
#ARCHIVE_MOUNT=/mnt/nas                             # host path bind-mounted read-only
#ARCHIVE_DIR=/mnt/nas/path/to/files                 # directory holding the files
#ARCHIVE_PATTERNS=sensorA_%Y%m%d_%H%M%S.wav         # one sensor -> mono
#ARCHIVE_PATTERNS=sensorA_%Y%m%d_%H%M%S.wav,sensorB_%Y%m%d_%H%M%S.wav,sensorC_%Y%m%d_%H%M%S.wav
#ARCHIVE_LABELS=port,starboard,aft                  # logged per channel, so channel order stays identifiable later
#ARCHIVE_FILE_SECONDS=300                           # length of each file, seconds
#ARCHIVE_DELAY=3600                                 # seconds behind real time (> write lag)

# ARCHIVE_GAINS is one value per channel, or one value for all; keep peaks < 0 dBFS to prevent clipping.
#ARCHIVE_GAINS=5                                    # linear gain dB on every channel (0=off)
#ARCHIVE_GAINS=5,5,8                                # per channel: +8 dB on a quieter third sensor

# --- iclisten mode (EXPERIMENTAL: live TCP from an icListen hydrophone) ---
#ICLISTEN_HOST=                        # hydrophone IP / hostname
#ICLISTEN_RATE=                        # device sample rate (configured in its web UI)
#ICLISTEN_FMT=s24le                    # ffmpeg input format matching the device output
