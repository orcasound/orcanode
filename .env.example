# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains credentials.

# AWS credentials
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
AWS_METADATA_SERVICE_TIMEOUT=5
AWS_METADATA_SERVICE_NUM_ATTEMPTS=0
REGION=us-west-2

# S3 bucket selection: prod | dev | custom
BUCKET_TYPE=dev
# BUCKET_STREAMING=my-custom-bucket   # only needed when BUCKET_TYPE=custom

# Node identity — must be unique per physical node; becomes the S3 key prefix
NODE_NAME=rpi_my_location

# Audio hardware — run `aplay -l` to find your card name
AUDIO_HW_ID=pisound
SAMPLE_RATE=48000
CHANNELS=2

# Streaming behaviour
# NODE_TYPE options: hls-only | research | debug | dev-virt-s3
NODE_TYPE=hls-only
SEGMENT_DURATION=10
FLAC_DURATION=30

# Loopback: play captured audio back through the speakers
# true = immediate loopback via JACK; hls = play back via HLS (adds ~20s delay); false = off
NODE_LOOPBACK=false
